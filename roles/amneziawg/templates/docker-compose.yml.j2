#jinja2: lstrip_blocks: True, trim_blocks: True
{{ ansible_managed | comment }}
services:
  amneziawg-{{ amneziawg_datacenter }}:
    container_name: amneziawg-{{ amneziawg_datacenter }}
    image: ghcr.io/ayastrebov/docker-amneziawg:{{ amneziawg_version }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - {{ amneziawg_data_dir }}:/config
    sysctls:
      net.ipv4.ip_forward: "1"
      net.ipv4.conf.all.src_valid_mark: "1"
    restart: unless-stopped
    environment:
      PUID: "{{ amneziawg_puid }}"
      PGID: "{{ amneziawg_pgid }}"
      TZ: "{{ amneziawg_timezone }}"
{% if amneziawg_mode == 'server' %}
      SERVERURL: "{{ amneziawg_serverurl }}"
      SERVERPORT: "{{ amneziawg_serverport }}"
      PEERS: "{{ amneziawg_peers }}"
      PEERDNS: "{{ amneziawg_peerdns }}"
      INTERNAL_SUBNET: "{{ amneziawg_internal_subnet }}"
      ALLOWEDIPS: "{{ amneziawg_allowedips | join(', ') }}"
      LOG_CONFS: "{{ amneziawg_log_confs | ternary('true', 'false') }}"
{% if amneziawg_persistentkeepalive_peers | length > 0 %}
      PERSISTENTKEEPALIVE_PEERS: "{{ amneziawg_persistentkeepalive_peers | join(',') }}"
{% endif %}
    ports:
      - "{{ amneziawg_serverport }}:{{ amneziawg_serverport }}/udp"
{% endif %}
{% if amneziawg_hosts_file | length > 0 %}
    extra_hosts:
  {% for dn, ip in amneziawg_hosts_file.items() %}
      {{ dn }}: {{ ip }}
  {% endfor %}
{% endif %}
