#jinja2: lstrip_blocks: True, trim_blocks: True
{{ ansible_managed | comment }}
services:
  amneziawg-{{ amneziawg_datacenter }}:
    container_name: amneziawg-{{ amneziawg_datacenter }}
    image: ghcr.io/ayastrebov/docker-amneziawg:{{ amneziawg_version }}
    cap_add:
      - NET_ADMIN
{% if amneziawg_mode in ['server', 'hub'] %}
      - SYS_MODULE
{% endif %}
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - {{ amneziawg_data_dir }}:/config
    sysctls:
      net.ipv4.ip_forward: 1
      net.ipv4.conf.all.src_valid_mark: 1
    restart: unless-stopped
    environment:
      PUID: "{{ amneziawg_puid }}"
      PGID: "{{ amneziawg_pgid }}"
      TZ: "{{ amneziawg_timezone }}"
{% if amneziawg_hosts_file | length > 0 %}
    extra_hosts:
  {% for dn, ip in amneziawg_hosts_file.items() %}
      {{ dn }}: {{ ip }}
  {% endfor %}
{% endif %}{% if amneziawg_mode in ['server', 'hub'] %}
{% set server_settings = amneziawg_server_defaults | combine(amneziawg_server) %}
{% for key, value in server_settings.items() %}
      {{ key }}: {{ value | string | to_json }}
{% endfor %}
    ports:
      - {{ server_settings.SERVERPORT }}:51820/udp
    networks:
      - amneziawg-{{ amneziawg_datacenter }}

networks:
  amneziawg-{{ amneziawg_datacenter }}:
    driver: bridge
    ipam:
      config:
        - subnet: {{ server_settings.INTERNAL_SUBNET }}/24
{% endif %}
